{
  "name": "@noctweave/js-client",
  "version": "0.1.0",
  "description": "Noctweave JavaScript protocol library, encrypted storage adapters, and browser integration shell.",
  "homepage": "https://github.com/luizwidmer/NoctweaveJS#readme",
  "bugs": {
    "url": "https://github.com/luizwidmer/NoctweaveJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizwidmer/NoctweaveJS.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "README.md",
    "client/",
    "desktop/",
    "electrobun.config.ts",
    "hutch.config.ts",
    "examples/browser-client/",
    "scripts/",
    "src/",
    "wasm/dist/",
    "wasm/noctweave_oqs_shim.c"
  ],
  "scripts": {
    "build:oqs-wasm": "bash scripts/build-oqs-wasm.sh",
    "dev:client": "NOCTWEAVE_CLIENT=production node examples/browser-client/server.js",
    "dev:browser-client": "node examples/browser-client/server.js",
    "desktop:dev": "bun desktop/scripts/run-electrobun.ts dev",
    "desktop:watch": "bun desktop/scripts/run-electrobun.ts dev --watch",
    "desktop:build": "bun desktop/scripts/build-desktop.ts",
    "desktop:prepare": "bun node_modules/electrobun/bin/electrobun.cjs prepare --env=stable",
    "desktop:test": "bun test desktop/checks",
    "desktop:icons": "bun desktop/scripts/generate-icons.ts",
    "smoke:relay": "node scripts/relay-smoke.js",
    "smoke:pairing-lobby": "node scripts/pairing-lobby-smoke.js",
    "smoke:noctweb-data": "node scripts/noctweb-data-smoke.js",
    "typecheck:desktop": "tsc --noEmit",
    "test": "node --test"
  },
  "keywords": [
    "noctweave",
    "relay",
    "privacy",
    "federation"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "overrides": {
    "ip-address": "10.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/three": "^0.185.1",
    "electrobun": "2.0.2",
    "png2icons": "^2.0.1",
    "typescript": "^7.0.2"
  }
}
